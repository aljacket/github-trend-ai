# Backend URL (frontend → backend). Defaults to http://localhost:3001 in dev.
VITE_BACKEND_URL=http://localhost:3001

# GitHub API Token (server-side only — used by backend to call GitHub).
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Claude OAuth token from your Max plan. Get it via: claude setup-token
# Used by the backend to call Haiku via @anthropic-ai/claude-agent-sdk.
CLAUDE_CODE_OAUTH_TOKEN=

# Comma-separated list of allowed origins for backend CORS (e.g. https://your-site.netlify.app).
# Leave empty in dev to allow all.
ALLOWED_ORIGINS=
